{
  "name": "siperma-erp",
  "version": "1.0.0",
  "description": "SIPERMA - Sistem Informasi ERP Pembayaran dan Keuangan Mahasiswa",
  "main": "src/services-js/AuthService.js",
  "scripts": {
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "test:e2e": "playwright test",
    "test:api": "newman run docs/testing/postman-collection.json"
  },
  "keywords": [
    "siperma",
    "erp",
    "sqa",
    "testing",
    "jest",
    "playwright"
  ],
  "author": "SIPERMA Team",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "jest": "^29.7.0",
    "newman": "^6.2.0"
  },
  "jest": {
    "collectCoverage": true,
    "coverageDirectory": "coverage",
    "collectCoverageFrom": [
      "src/services-js/**/*.js"
    ],
    "coverageReporters": [
      "text",
      "lcov",
      "html"
    ],
    "testMatch": [
      "**/tests/jest/**/*.test.js"
    ]
  }
}

